# Настройки запуска: cp .env.example .env && docker compose up --build.
# Значения пустые — compose берёт значения по умолчанию (docker-compose.yml, x-app.environment);
# они указаны в комментариях. Заполнять нужно только ключи. Ключи жюри — в secrets.env.age.

# Режим данных (по умолчанию db): db — база, куда init загрузил пакеты городов;
# fixtures — заглушки из фактов v9 без базы (интерфейс без Docker: uv run uvicorn …)
DATA_MODE=

# База, сервис db (по умолчанию oznayu / oznayu / oznayu). Адрес для init и app compose собирает
# из этих значений. В пароле не использовать @ : / — он входит в адрес базы.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Только для запуска вне Docker (uv run …): make db поднимает базу на 127.0.0.1:55432 —
# postgresql+psycopg://oznayu:oznayu@localhost:55432/oznayu; пакеты — packs
DATABASE_URL=
PACKS_DIR=
# Прогрев кеша базы запросами показа после загрузки пакетов (по умолчанию 1 — да)
WARMUP=

# LLM-шлюз (D44). Провайдер и модель по умолчанию — gigachat и GigaChat-3-Ultra, адрес
# https://api.giga.chat/v1 (формат OpenAI chat/completions). Без ключа — разбор правилами.
# Claude: LLM_PROVIDER=openai_compat, LLM_MODEL=claude-opus-5-5,
# LLM_BASE_URL=https://api.anthropic.com/v1/ (из России не работает).
LLM_PROVIDER=
LLM_MODEL=
# Ключ авторизации GigaChat API — из личного кабинета на developers.sber.ru
# (для жюри — отдельный ключ). Токен на 30 минут шлюз получает сам.
LLM_API_KEY=
LLM_BASE_URL=
# Тип ключа GigaChat (по умолчанию GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B / _CORP — организация)
GIGACHAT_SCOPE=
# Усилие модели (по умолчанию low) и таймаут ответа, с (по умолчанию 20)
LLM_EFFORT=
LLM_TIMEOUT_S=
# Повторы при сбое сети или лимите (по умолчанию 1): худший случай — LLM_TIMEOUT_S × (1 + повторы)
LLM_MAX_RETRIES=
# Серверный запасной путь Anthropic при отказе модели: default (по умолчанию) | off
LLM_ANTHROPIC_FALLBACKS=
# Запасной провайдер шлюза (необязательно): openai_compat + модель, ключ и адрес
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# Ключ 2ГИС (необязательно): время на общественном транспорте на запросе.
# Кабинет разработчика 2ГИС → ключ API (Routing, Public Transport, Places).
TWOGIS_API_KEY=
