# Настройки запуска: cp .env.example .env. Значения ниже подходят для docker compose up --build как есть.
# Без .env compose берёт те же значения по умолчанию (docker-compose.yml, x-app.environment).

# Режим данных: db — база, куда init загрузил пакеты городов (так у жюри);
# fixtures — заглушки из фактов v9 без базы (интерфейс без Docker: uv run uvicorn …)
DATA_MODE=db

# База (сервис db). Адрес для init и app compose собирает из этих значений.
# В пароле не использовать @ : / — он входит в адрес базы.
POSTGRES_USER=oznayu
POSTGRES_PASSWORD=oznayu
POSTGRES_DB=oznayu

# Только для запуска вне Docker (uv run …): make db поднимает базу на 127.0.0.1:55432
DATABASE_URL=postgresql+psycopg://oznayu:oznayu@localhost:55432/oznayu
PACKS_DIR=packs

# LLM-шлюз (D21): anthropic — основной, openai_compat (YandexGPT / GigaChat) — запасной, off — выключен.
# Без ключа разбор запроса идёт правилами (офлайн-режим, с пометкой в интерфейсе).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
# Глубина рассуждений Claude: low | medium | high | xhigh | max
LLM_EFFORT=low
LLM_TIMEOUT_S=20
# Повторы при сбое сети или лимите: худший случай ответа — LLM_TIMEOUT_S × (1 + повторы)
LLM_MAX_RETRIES=1
# Серверный запасной путь Anthropic при отказе модели: default | off
LLM_ANTHROPIC_FALLBACKS=default
# Запасной провайдер шлюза (необязательно): openai_compat + адрес и ключ
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
