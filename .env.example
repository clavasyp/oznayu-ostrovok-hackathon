# Режим данных: fixtures — заглушки из фактов v9 (без базы); db — база после init
DATA_MODE=fixtures

# База (сервис db в docker compose)
DATABASE_URL=postgresql+psycopg://oznayu:oznayu@db:5432/oznayu
PACKS_DIR=packs

# LLM-шлюз (D21): anthropic — основной, openai-совместимый — запасной
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
