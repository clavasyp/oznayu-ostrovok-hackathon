        "feature_id": {
          "description": "ID характеристики каталога, например V05 или W01",
          "title": "Feature Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "exists"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Какое поле значения сравнивать: distance_m, count, mean…",
          "title": "Field"
        },
        "params": {
          "additionalProperties": true,
          "description": "Параметры: месяц, цель маршрута, время приезда",
          "title": "Params",
          "type": "object"
        },
        "binding": {
          "default": "same_placement",
          "description": "Условия уровня номера проверяются на одном размещении (D17)",
          "enum": [
            "same_placement",
            "hotel"
          ],
          "title": "Binding",
          "type": "string"
        },
        "quantifier": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Quantifier",
          "type": "string"
        },
        "text_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Фрагмент запроса, откуда условие",
          "title": "Text Span"
        },
        "atom_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID атома запроса (v11: AST без потерь)",
          "title": "Atom Id"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "default": "explicit",
          "description": "Явно сказано или выведено (выведенное — только уточнение)",
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "mapping": {
          "default": "exact",
          "description": "Насколько смысл атома совпадает с характеристикой",
          "enum": [
            "exact",
            "partial",
            "different_meaning"
          ],
          "title": "Mapping",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "feature_id",
        "op",
        "weight"
      ],
      "title": "SoftCondition",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Фрагмент исходного текста: позиции в Unicode code points, полуинтервал [start, end) (v11).",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "raw_text": {
      "title": "Raw Text",
      "type": "string"
    },
    "city_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "City Id"
    },
    "areas": {
      "description": "Только отели этих районов города (`subzone_id`)",
      "items": {
        "type": "string"
      },
      "title": "Areas",
      "type": "array"
    },
    "exclude_areas": {
      "description": "Без отелей этих районов: «не в Адлере»",
      "items": {
        "type": "string"
      },
      "title": "Exclude Areas",
      "type": "array"
    },
    "kinds": {
      "description": "Только этот тип жилья (`kind` Островка): «хостел»",
      "items": {
        "type": "string"
      },
      "title": "Kinds",
      "type": "array"
    },
    "stars_min": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Звёзд на Островке не меньше: «пятизвёздочный», «4 звезды»",
      "title": "Stars Min"
    },
    "dates": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dates"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "guests": {
      "anyOf": [
        {
          "$ref": "#/$defs/Guests"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "hard": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "title": "Hard",
      "type": "array"
    },
    "soft": {
