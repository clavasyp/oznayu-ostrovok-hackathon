{
  "$defs": {
    "Clarification": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "about": {
          "description": "Какую неоднозначность снимает: «тихо» — в номере или у дорог",
          "title": "About",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "question",
        "about"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "description": "ID характеристики каталога, например V05 или W01",
          "title": "Feature Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "in",
            "exists"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Какое поле значения сравнивать: distance_m, count, mean…",
          "title": "Field"
        },
        "params": {
          "additionalProperties": true,
          "description": "Параметры: месяц, цель маршрута, время приезда",
          "title": "Params",
          "type": "object"
        },
        "binding": {
          "default": "same_placement",
          "description": "Условия уровня номера проверяются на одном размещении (D17)",
          "enum": [
            "same_placement",
            "hotel"
          ],
          "title": "Binding",
          "type": "string"
        },
        "quantifier": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Quantifier",
          "type": "string"
        },
        "text_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Фрагмент запроса, откуда условие",
          "title": "Text Span"
        },
        "atom_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID атома запроса (v11: AST без потерь)",
          "title": "Atom Id"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "default": "explicit",
          "description": "Явно сказано или выведено (выведенное — только уточнение)",
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "mapping": {
          "default": "exact",
          "description": "Насколько смысл атома совпадает с характеристикой",
          "enum": [
            "exact",
            "partial",
            "different_meaning"
          ],
          "title": "Mapping",
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Dates": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To"
        }
      },
      "title": "Dates",
      "type": "object"
    },
    "Guests": {
      "additionalProperties": false,
      "properties": {
        "adults": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adults"
        },
        "children_ages": {
          "items": {
            "type": "integer"
          },
          "title": "Children Ages",
          "type": "array"
        },
        "pets": {
          "items": {
            "type": "string"
          },
          "title": "Pets",
          "type": "array"
        }
      },
      "title": "Guests",
      "type": "object"
    },
    "LogicNode": {
      "additionalProperties": false,
      "description": "Узел логики запроса (v11).\n\nATOM ссылается на условие по atom_id; AND / OR / NOT — на детей.",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "op": {
          "enum": [
            "ATOM",
            "AND",
            "OR",
            "NOT"
          ],
          "title": "Op",
          "type": "string"
        },
        "atom_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atom Id"
        },
        "children": {
          "items": {
            "type": "string"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "op"
      ],
      "title": "LogicNode",
      "type": "object"
    },
    "NearbyPlace": {
      "additionalProperties": false,
      "description": "«Рядом место типа X» (задача 4): категория из `agents/catalog/places.json` и радиус.\n\nПроверить можно, когда в пакете города будет таблица «отель × места рядом» (метки OSM,\nрубрики 2ГИС); до тех пор часть запроса — «вне каталога», но уже с категорией.",
      "properties": {
        "category": {
          "description": "ID категории из словаря мест",
          "title": "Category",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "radius_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Пешком; None — место в отеле",
          "title": "Radius M"
        },
        "radius_source": {
          "anyOf": [
            {
              "enum": [
                "guest",
                "policy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "guest — гость назвал расстояние; policy — «рядом» = near_m",
          "title": "Radius Source"
        },
        "on_site": {
          "default": false,
          "description": "«в отеле», «отель с рестораном»",
          "title": "On Site",
          "type": "boolean"
        },
        "quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "«хорошие», «лучшие», «вкусные» — слова гостя о качестве; проверить нечем",
          "title": "Quality"
        }
      },
      "required": [
        "category",
        "label"
      ],
      "title": "NearbyPlace",
      "type": "object"
    },
    "OutOfCatalog": {
      "additionalProperties": false,
      "description": "Часть запроса без характеристики в каталоге (D34): показываем «такое мы пока не знаем».",
      "properties": {
        "text_span": {
          "title": "Text Span",
          "type": "string"
        },
        "normalized": {
          "title": "Normalized",
          "type": "string"
        },
        "kind": {
          "default": "missing_feature",
          "enum": [
            "missing_feature",
            "subjective",
            "unsupported_param"
          ],
          "title": "Kind",
          "type": "string"
        },
        "atom_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atom Id"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requiredness": {
          "default": "unspecified",
          "enum": [
            "required",
            "desired",
            "unspecified"
          ],
          "title": "Requiredness",
          "type": "string"
        },
        "mapping_status": {
          "default": "unmatched",
          "enum": [
            "partial",
            "different_meaning",
            "unmatched"
          ],
          "title": "Mapping Status",
          "type": "string"
        },
        "nearest_contracts": {
          "description": "Ближайшие характеристики каталога, если есть",
          "items": {
            "type": "string"
          },
          "title": "Nearest Contracts",
          "type": "array"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/NearbyPlace"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Для `nearby_place`: что и где"
        }
      },
      "required": [
        "text_span",
        "normalized"
      ],
      "title": "OutOfCatalog",
      "type": "object"
    },
    "SoftCondition": {
      "additionalProperties": false,
