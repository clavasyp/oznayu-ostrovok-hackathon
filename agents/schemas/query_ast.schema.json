      "title": "Out Of Catalog",
      "type": "array"
    },
    "logic": {
      "description": "Необязательно: граф AND / OR / NOT; пусто — все hard соединены через AND",
      "items": {
        "$ref": "#/$defs/LogicNode"
      },
      "title": "Logic",
      "type": "array"
    },
    "hard_root": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Корень графа обязательных условий",
      "title": "Hard Root"
    },
    "unparsed_spans": {
      "description": "Неразобранные фрагменты — не теряются молча",
      "items": {
        "$ref": "#/$defs/Span"
      },
      "title": "Unparsed Spans",
      "type": "array"
    },
    "parsed_by": {
      "default": "llm",
      "enum": [
        "llm",
        "rules",
        "stub"
      ],
      "title": "Parsed By",
      "type": "string"
    }
  },
  "required": [
    "raw_text"
  ],
  "title": "QueryAST",
  "type": "object"
}
