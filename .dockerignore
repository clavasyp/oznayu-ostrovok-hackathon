# В образ идут только код, миграции, пакеты городов и исходники интерфейса.
.git
.github
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Секреты и локальные настройки
.env*

# Память проекта, отчёты, сырые данные и тесты — не нужны для запуска
docs
reports
research_notes
data
tests

# Интерфейс собирается внутри образа заново
ui/node_modules
ui/dist

# Тяжёлые исходники расчётов
*.osm.pbf
*.tif
*.nc

# Запуск и разработка
Dockerfile
docker-compose*.yml
Makefile
.DS_Store
.idea
.vscode
